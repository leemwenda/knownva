# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# App
APP_NAME=KnowVa
SESSION_COOKIE_NAME=knowva_session
# Free-tier allowance: how many premium resources a free account may download per calendar month
FREE_MONTHLY_PREMIUM_DOWNLOADS=3
# Private storage for uploaded documents (keep OUTSIDE the web root)
STORAGE_DIR=./storage

# Payments — leave unset to use the development-only fake checkout (refused in production)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email — leave unset and verification/reset links are printed to the server log instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KnowVa <no-reply@knowva.app>"
