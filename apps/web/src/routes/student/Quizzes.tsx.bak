import { PlayCircle, CheckCircle2, Clock } from 'lucide-react';

export function Quizzes() {
  const quizzes = [
    { title: "Database Normalization", questions: 10, time: "15 mins", status: "Available", score: null },
    { title: "Operating Systems Midterm", questions: 25, time: "45 mins", status: "Completed", score: "88%" },
    { title: "Network Protocols", questions: 15, time: "20 mins", status: "Available", score: null }
  ];

  return (
    <div className="space-y-6 animate-in fade-in duration-500">
      <div>
        <h1 className="text-3xl font-bold text-slate-900 mb-1">Practice Quizzes</h1>
        <p className="text-slate-500">Test your knowledge and prepare for exams.</p>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {quizzes.map((q, i) => (
          <div key={i} className="card p-6 flex flex-col">
            <div className="flex justify-between items-start mb-4">
              <div className={`p-3 rounded-xl ${q.status === 'Completed' ? 'bg-green-50 text-green-600' : 'bg-brand-50 text-brand-600'}`}>
                {q.status === 'Completed' ? <CheckCircle2 className="h-6 w-6"/> : <PlayCircle className="h-6 w-6"/>}
              </div>
              {q.score && <span className="text-sm font-extrabold text-green-600 bg-green-50 px-2 py-1 rounded">{q.score}</span>}
            </div>
            <h3 className="font-bold text-lg text-slate-900 mb-2">{q.title}</h3>
            <div className="flex items-center gap-4 text-xs font-semibold text-slate-500 mb-6">
              <span>{q.questions} Questions</span>
              <span className="flex items-center gap-1"><Clock className="h-3 w-3"/> {q.time}</span>
            </div>
            <button className={`mt-auto w-full py-2.5 rounded-xl font-bold text-sm ${q.status === 'Completed' ? 'bg-slate-100 text-slate-600 hover:bg-slate-200' : 'bg-brand-600 text-white hover:bg-brand-500'}`}>
              {q.status === 'Completed' ? 'View Results' : 'Start Quiz'}
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}
