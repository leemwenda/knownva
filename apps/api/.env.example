# Core
NODE_ENV=development
PORT=5000
BIND_HOST=127.0.0.1
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Database
DATABASE_URL="mysql://knownva:knownva@127.0.0.1:3306/knownva_dev"

# Auth
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email (leave blank → links printed to log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KnowVa <no-reply@knownva.app>"
SMTP_REPLY_TO=support@knownva.app

# Storage
STORAGE_DIR=./storage
FREE_MONTHLY_PREMIUM_DOWNLOADS=3

# Google OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Stripe (Phase 7)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# AI (Phase 4)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
SHADOW_DATABASE_URL="mysql://knownva:knownva@127.0.0.1:3307/knownva_shadow"
