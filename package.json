{
  "name": "knownva",
  "private": true,
  "version": "2.0.0",
  "description": "KnowVa Academic Resource Platform — production monorepo",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.11.0 <21" },
  "scripts": {
    "dev:api": "npm run dev -w @knownva/api",
    "dev:web": "npm run dev -w @knownva/web",
    "build": "npm run build -w @knownva/shared && npm run build -w @knownva/api && npm run build -w @knownva/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @knownva/api",
    "prisma:migrate": "npm run prisma:migrate -w @knownva/api",
    "prisma:deploy": "npm run prisma:deploy -w @knownva/api"
  }
}
